# Build artifacts (the whole workspace shares one root target dir)
/target
# The dev tools under tools/ are separate workspaces with their own build dirs
tools/*/target/

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# Local environment and secrets: never commit real account credentials
.env
.env.*

# Offline signing seeds, one per signed catalog: they stay on the maintainer's machine
/.catalog-signing/

# Corpus cache: boot patches fetched by URL+SHA256 on demand, keyed by digest, never checked in
/.corpus-cache/

# Block indexes: derived, ~94 MB a set, published as release assets and pinned by the signed
# manifest beside this path, never committed (site/indexes/README.md)
/site/indexes/artifacts/

# OS cruft
.DS_Store

# Editor and IDE files
/.idea/
/.vscode/
*.swp
*~
