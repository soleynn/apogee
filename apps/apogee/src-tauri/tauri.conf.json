{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apogee",
  "identifier": "io.github.soleynn.apogee",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apogee",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'none';\nscript-src 'self';\nstyle-src 'self';\nimg-src 'self' asset: http://asset.localhost data:;\nfont-src 'self';\nconnect-src ipc: http://ipc.localhost;\nbase-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
