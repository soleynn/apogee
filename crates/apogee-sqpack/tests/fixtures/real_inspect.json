{
  "//": "What a structural sweep of a pristine retail install accounts for, measured out of process by a separate implementation of the format. Counts, byte totals and file names only: no Square Enix bytes. Every field of `structure`, `walk`, `hash` and each archive's `totals` is one field of the crate's own accounting struct, in its declaration order.",
  "version": "2026.07.16.0001.0000",
  "install": {
    "repos": ["ffxiv", "ex1", "ex2", "ex3", "ex4", "ex5"],
    "//dats_without_magic": "Data files carrying something other than the SqPack magic in their first eight bytes. Their self hash still covers what is there, so refusing them would make a fifth of an install unreadable.",
    "dats_without_magic": 19,
    "//empty_archives": "Archives holding no entries at all: an empty entry segment, no folder table, a 2048-byte dat0 with an empty data region, and a collision table terminated by a record whose key is all ones in the container's key width rather than in the whole 64-bit field.",
    "empty_archives": [
      "ex1/020100",
      "ex1/120100",
      "ex2/020200",
      "ex3/020300",
      "ex4/020400",
      "ex5/020500",
      "ffxiv/120000",
      "ffxiv/130000"
    ],
    "//unclaimed_data_hash": "Data files declaring an all-zero digest over their data region, which claims nothing and so is counted rather than compared. The other six empty archives declare the digest of nothing instead.",
    "unclaimed_data_hash": ["ffxiv/120000", "ffxiv/130000"],
    "//unclaimed_share_per_mille": "Data-region bytes no slot covers, per thousand: about one percent of a full install is space a patch wiped and nothing reoccupied.",
    "unclaimed_share_per_mille": 10,
    "//must_not_appear": "The defects whose absence was measured over the whole install rather than argued: zero overlapping slots, zero slots outside the declared region, zero unreadable entry headers, every wiped run tiled exactly, every collision path hashing to its own key, both index forms naming the same places. A sweep reporting one of these on a pristine install is a bug in the sweep.",
    "must_not_appear": [
      "container-unreadable",
      "header-hash-mismatch",
      "segment-hash-mismatch",
      "data-region-hash-mismatch",
      "declared-length",
      "declared-dat-count",
      "collision-table-unterminated",
      "collision-record-after-terminator",
      "collision-path-key-mismatch",
      "forms-disagree",
      "entry-header-unreadable",
      "entry-content-type-unknown",
      "occupied-exceeds-allocated",
      "slots-overlap",
      "slot-before-data-region",
      "slot-beyond-data-region",
      "gap-not-empty-block-chain"
    ],
